{
  "name": "projeto-final-pra-ver-se-sou-bom",
  "version": "1.0.0",
  "description": "Projeto Express, TypeScript, Prisma e MySQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/workers/workerDaniel.ts",
    "worker:start": "node dist/workers/workerDaniel.js",
    "worker:webhook:dev": "tsx watch src/workers/workerWebhook.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "amqplib": "^2.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}